[Unit]
Description=Safe Code 214 WebFetch HTTPS fixture
ConditionHost=tom666

[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/python3 -I -B /opt/safe-code/webfetch-fixture/webfetch_test_fixture.py
LoadCredential=tls.crt:/etc/safe-code-webfetch-fixture/tls.crt
LoadCredential=tls.key:/etc/safe-code-webfetch-fixture/tls.key
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
IPAddressDeny=any
IPAddressAllow=127.0.0.0/8
RestrictAddressFamilies=AF_INET
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
