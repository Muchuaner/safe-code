#!/bin/bash
set -euo pipefail

if [[ $EUID != 0 || $(hostname) != tom666 ]] ||
   ! ip -4 -o addr show | awk '$4 ~ /^192[.]168[.]50[.]66\// { found=1 } END { exit !found }'; then
    printf '%s\n' 'Run as root on the 214 test VM.' >&2
    exit 1
fi
if [[ $# == 0 ]]; then
    printf '%s\n' 'Usage: run COMMAND [ARGUMENTS...]' >&2
    exit 2
fi

systemctl is-active --quiet safe-code-webfetch-fixture.service
fixture_hosts=$(mktemp)
trap 'rm -f -- "$fixture_hosts"' EXIT
awk '
    {
        for (i=2; i<=NF && $i !~ /^#/; i++) {
            host=tolower($i)
            sub(/\.$/, "", host)
            if (host == "api.anthropic.com" || host == "webfetch-fixture.test" ||
                host == "redirect-target.webfetch-fixture.test") {
                conflict=1
            }
        }
        print
    }
    END {
        if (conflict) exit 1
        print "127.0.0.2 api.anthropic.com webfetch-fixture.test redirect-target.webfetch-fixture.test"
    }
' /etc/hosts > "$fixture_hosts"
chmod 0644 "$fixture_hosts"
unshare --mount --propagation private -- /bin/bash -euc '
    mount --bind "$1" /etc/hosts
    mount -o remount,bind,ro /etc/hosts
    shift
    exec runuser -u workspace -- env \
        -u http_proxy -u HTTP_PROXY -u https_proxy -u HTTPS_PROXY -u ALL_PROXY -u all_proxy \
        NODE_EXTRA_CA_CERTS=/etc/safe-code-webfetch-fixture/ca.crt \
        CURL_CA_BUNDLE=/etc/safe-code-webfetch-fixture/ca.crt \
        "$@"
' webfetch-fixture "$fixture_hosts" "$@"
