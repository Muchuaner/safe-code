<Project>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Keep absolute paths to the build machine out of distributed assemblies. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PathMap>$(MSBuildThisFileDirectory)=/_/src/</PathMap>
  </PropertyGroup>
</Project>
